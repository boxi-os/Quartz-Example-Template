filters:
  and:
    - file.ext == "md"
    - '!file.inFolder("en")'
views:
  - type: list
    name: Nach Kapitel
    groupBy:
      property: section
      direction: ASC
    order:
      - title
      - description
    sort:
      - property: title
        direction: ASC
  - type: table
    name: Als Tabelle
    order:
      - title
      - section
      - description
    sort:
      - property: section
        direction: ASC
      - property: title
        direction: ASC
