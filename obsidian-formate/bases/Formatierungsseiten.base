filters:
  and:
    - file.hasTag("formatierung")
    - file.ext == "md"
formulas:
  Bereich: file.folder
views:
  - type: table
    name: Als Tabelle
    order:
      - title
      - description
      - formula.Bereich
    sort:
      - property: file.name
        direction: ASC
  - type: cards
    image: cover
    name: Als Karten
    order:
      - description
    sort:
      - property: file.name
        direction: ASC
